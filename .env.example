# ============================================================
# Blogify SSR - environment configuration
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ============================================================

# --- Required ---

# Secret used to sign/verify JWT access tokens (cookie auth).
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY_FOR_ACCESS_TOKEN=change-me-to-a-long-random-string

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/blogify

# --- Optional ---

# Server port (defaults to 3000 if unset).
# PORT=3000

# Set to "production" when deploying.
# Enables the `secure` flag on auth cookies (HTTPS only).
# NODE_ENV=production
