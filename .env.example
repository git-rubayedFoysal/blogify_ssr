# Secret used to sign/verify JWT access tokens (cookie auth).
# NEVER commit the real .env file.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY_FOR_ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional: set to "production" when deploying
# (used for secure cookie flags in the auth middleware)
# NODE_ENV=production
