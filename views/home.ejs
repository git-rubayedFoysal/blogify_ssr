<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("./partials/head.ejs") %>
        <title>Homepage</title>
</head>

<body>
    <%- include("./partials/nav.ejs") %>
        <div class="container mt-3">
            <% if (locals.blogs) { %>
                <div class="row g-3">
                    <% locals.blogs.forEach(blog=> { %>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card h-100">
                                <img src="<%=blog.coverImageURL %>" class="card-img-top" alt="<%=blog.title %>">
                                <div class="card-body d-flex flex-column my-2">
                                    <h5 class="card-title">
                                        <%=blog.title %>
                                    </h5>

                                    <p class="card-text blog-excerpt">
                                        <%=blog.body %>
                                    </p>

                                    <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-auto">Continue Read</a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>

        </div>


        <%- include("./partials/script.ejs") %>
</body>

</html>